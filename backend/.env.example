PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/campusflow.sqlite
UPLOAD_DIRECTORY=./data/uploads
CAMPUSFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional first-run admin bootstrap. Leave blank until a server operator sets
# unique credentials directly in the deployment environment or private .env.
CAMPUSFLOW_ADMIN_EMAIL=
CAMPUSFLOW_ADMIN_PASSWORD=