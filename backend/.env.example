# Node.js backend
PORT=3001
NODE_ENV=development

# SQLite configuration
DATABASE_PATH=./data/campusflow.sqlite
UPLOAD_DIRECTORY=./data/uploads
CAMPUSFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL configuration for the Python backend
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusflow
DB_USER=root
DB_PASSWORD=

# Authentication
JWT_SECRET=

# Optional first-run admin bootstrap
CAMPUSFLOW_ADMIN_EMAIL=
CAMPUSFLOW_ADMIN_PASSWORD=
